; Engine configuration file.
; Godot 3.5 project. Input actions are created in code (src/autoload/Settings.gd)
; so they can be remapped from the Options menu.

config_version=4

[application]

config/name="ZX-Legacy"
run/main_scene="res://src/ui/Title.tscn"
config/icon="res://icon.png"

[autoload]

Settings="*res://src/autoload/Settings.gd"
Audio="*res://src/autoload/Audio.gd"
Screen="*res://src/autoload/Screen.gd"
Game="*res://src/autoload/Game.gd"

[display]

window/size/width=398
window/size/height=224
window/size/test_width=1194
window/size/test_height=672
window/stretch/mode="2d"
window/stretch/aspect="keep"

[rendering]

2d/snapping/use_gpu_pixel_snap=true
environment/default_clear_color=Color( 0, 0, 0, 1 )
